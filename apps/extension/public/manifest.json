{
  "manifest_version": 3,
  "name": "Swearch — Research Condensation",
  "version": "0.1.0",
  "description": "Highlight research papers to get AI summaries, extract insights, and export to Google Docs. Organize findings by project.",
  "homepage_url": "https://swearch.app",
  "permissions": [
    "activeTab",
    "storage",
    "identity",
    "tabs",
    "scripting",
    "contextMenus",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "oauth2": {
    "client_id": "__GOOGLE_CLIENT_ID__",
    "scopes": [
      "https://www.googleapis.com/auth/drive.readonly",
      "https://www.googleapis.com/auth/documents"
    ]
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["__WEB_APP_MATCHES__"],
      "js": ["content/auth-sync.js"],
      "run_at": "document_idle"
    }
  ],
  "externally_connectable": {
    "matches": ["__WEB_APP_MATCHES__"]
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/popup/index.html",
        "popup.js",
        "popup.css",
        "chunks/*",
        "icons/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
