# Supabase (Extension + shared)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Google OAuth Client ID (for extension chrome.identity)
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Web app — Next.js requires NEXT_PUBLIC_ prefix for client-side vars
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Supabase Edge Function secrets — set via CLI, never put the actual value here:
# supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_API_KEY is NOT exposed to any client bundle
