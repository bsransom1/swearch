# Supabase (Extension + shared)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Google OAuth Client ID (for extension chrome.identity — Drive/Docs access)
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Web-app origin(s) the extension is allowed to sync auth with (comma-separated).
# Used for the auth-sync content script + externally_connectable manifest matches
# and the "Sign in on web app" link. Defaults to http://localhost:3000 if unset.
VITE_WEB_APP_ORIGINS=http://localhost:3000,https://swearch.app

# Web app — Next.js requires NEXT_PUBLIC_ prefix for client-side vars
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Chrome extension ID — target for web -> extension session sync via
# chrome.runtime.sendMessage. Find it at chrome://extensions after loading the
# unpacked build. Without it the web app cannot push sessions to the extension.
NEXT_PUBLIC_EXTENSION_ID=your_extension_id_here

# Public web app URL (used for OAuth redirects/docs in production).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Edge Function secrets — set via CLI, never put the actual value here:
# supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_API_KEY is NOT exposed to any client bundle
